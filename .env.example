# Backend Configuration
SECRET_KEY=dev-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Note: If PostgreSQL is unreachable, backend automatically falls back to SQLite (real_estate.db)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/real_estate

# Frontend API URL
EXPO_PUBLIC_API_URL=http://localhost:8000/api
